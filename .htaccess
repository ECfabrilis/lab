# En local (WAMP), tout le projet est sous la racine web : seul le dossier
# public/ doit être accessible depuis le navigateur. La partie privée
# (includes, config.php, sql, logs, sauvegardes) est interdite.
# Sur Hostinger, la partie privée est hors de public_html : ce fichier n'y sert pas.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?!public/) - [F]
</IfModule>
