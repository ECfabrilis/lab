# Dossier public de l'application
# Seul dossier ouvert au web : cette ligne l'emporte sur l'interdiction générale
# que pose le .htaccess de la racine quand le module de réécriture est absent.
Require all granted
Options -Indexes
DirectoryIndex index.php

# Les fichiers techniques (_chemins.php, modèles) ne s'ouvrent pas depuis le navigateur.
<FilesMatch "^_">
    Require all denied
</FilesMatch>

# Fichiers cachés (.git, .env...) : jamais servis.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
